# Copy into the service environment; generate unique random values for deployment.
FLASK_SECRET_KEY=replace-with-a-long-random-secret
DEVICE_API_TOKEN=replace-with-a-different-long-random-token
API_BASE_URL=http://192.168.1.10:5000
API_TIMEOUT_SECONDS=5
DATABASE_URL=sqlite:///users.db
FLASK_DEBUG=0
BASELINE_MODE=0
SIMULATE_HARDWARE=0
SIMULATED_RFID_ID=1234567890
ALLOW_DEMO_CODES=0
MAIL_USERNAME=your_gmail@gmail.com
MAIL_PASSWORD=your_16_char_app_password
